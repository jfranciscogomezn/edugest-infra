{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeployArtifacts",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::__BUCKET__/*"
    },
    {
      "Sid": "ReadQaParams",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath"],
      "Resource": "arn:aws:ssm:__REGION__:__ACCOUNT__:parameter/edugest/qa*"
    }
  ]
}
